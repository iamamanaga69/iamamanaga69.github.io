---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/animations.css';
import '../styles/pages.css';
import '../styles/mobile-fixes.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageId?: string;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
}

const {
  title,
  description,
  canonical = 'https://flexist.in/',
  ogImage = 'https://flexist.in/assets/images/flexist-og.png',
  pageId = 'home',
  robots = 'index, follow',
  schema,
  preloadImage,
} = Astro.props;

const schemaJson = schema ? JSON.stringify(schema) : '';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <title>{title}</title>

  <!-- SEO Meta Tags -->
  <link rel="canonical" href={canonical}>
  <link rel="sitemap" type="application/xml" title="Sitemap" href="https://flexist.in/sitemap.xml">
  <meta name="robots" content={robots}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Flexist">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonical}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  
  <link rel="icon" type="image/png" href="/assets/images/flexist-avatar-192.png">
  {preloadImage && <link rel="preload" href={preloadImage} as="image">}
  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

  <!-- Brand fonts (loaded globally so every page renders in the correct typefaces) -->
  <!-- Loaded non-render-blocking: text paints immediately in fallback, then swaps in. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Syne:wght@600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Syne:wght@600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Syne:wght@600;700&display=swap" rel="stylesheet"></noscript>

  <slot name="head" />
</head>
<body data-page={pageId}>
  <!-- Floating Ambient Orbs (kept minimal for a calmer, premium feel) -->
  <div class="bg-orb bg-orb-1" aria-hidden="true"></div>
  <div class="bg-orb bg-orb-2" aria-hidden="true"></div>
  <div data-site-nav>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-nav">
      <div class="container nav-inner">
        <a class="brand brand-premium" href="/" aria-label="Flexist home">
          <span class="brand-mark">
            <img class="brand-avatar" src="/assets/images/flexist-avatar-192.png" alt="Flexist Logo">
            <i></i>
          </span>
          <span class="brand-copy">
            <span class="wordmark gradient-text">Flexist</span>
            <small>Web3 India Labs</small>
          </span>
        </a>
        <nav class="nav-links" id="site-menu" aria-label="Primary navigation">
          <a class={pageId === 'home' ? 'active' : ''} href="/">Home</a>
          <a class={pageId === 'flexistlabs' ? 'active' : ''} href="/flexistlabs">FlexistLabs</a>
          <a class={pageId === 'services' ? 'active' : ''} href="/services">Services</a>
          <a class={pageId === 'resources' ? 'active' : ''} href="/resources">Resources</a>
          
          <div class={`nav-group ${['plans', 'india-entry', 'india-growth', 'india-partner'].includes(pageId) ? 'active' : ''}`}>
            <a class={`nav-group-label ${['plans', 'india-entry', 'india-growth', 'india-partner'].includes(pageId) ? 'active' : ''}`} href="/plans">Plans</a>
            <div class="nav-panel" aria-label="Plans links">
              <a class={pageId === 'plans' ? 'active' : ''} href="/plans"><strong>Compare Plans</strong><small>Bundled India growth packages</small></a>
              <a class={pageId === 'india-entry' ? 'active' : ''} href="/plans/india-entry"><strong>India Entry</strong><small>Pre-launch essentials</small></a>
              <a class={pageId === 'india-growth' ? 'active' : ''} href="/plans/india-growth"><strong>India Growth</strong><small>Full community and campaigns</small></a>
              <a class={pageId === 'india-partner' ? 'active' : ''} href="/plans/india-partner"><strong>India Partner</strong><small>Total India ownership</small></a>
            </div>
          </div>

          <a class={pageId === 'experience' ? 'active' : ''} href="/experience">Experience</a>
          <a class={pageId === 'about' ? 'active' : ''} href="/about">About</a>
          <a class={pageId === 'contact' ? 'active' : ''} href="/contact">Contact</a>
          <a class="nav-mobile-cta" href="/inquiry">Start Expansion</a>
        </nav>
        <div class="nav-actions">
          <div class="nav-socials" aria-label="Social links">
            <a class="social-icon" href="https://t.me/FlexistCrypto" target="_blank" rel="noreferrer" aria-label="Telegram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3 11.2l6.8 2.4L17 8.2l-5.4 6.8.2 5.1 3.1-3.5 4.2 3L21 4Z"></path></svg>
            </a>
            <a class="social-icon" href="https://x.com/flexistcrypto" target="_blank" rel="noreferrer" aria-label="X">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 12.4 16H20L7.6 4H4Zm16 0-7.3 8.2M11.4 15.2 4 20"></path></svg>
            </a>
            <a class="social-icon" href="https://linktr.ee/FlexistWeb3" target="_blank" rel="noreferrer" aria-label="Linktree">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M7 8l5-5 5 5M7 16l5 5 5-5M4 12h16"></path></svg>
            </a>
          </div>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch theme" title="Switch theme">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v3m0 14v3M4.9 4.9 7 7m10 10 2.1 2.1M2 12h3m14 0h3M4.9 19.1 7 17m10-10 2.1-2.1"></path></svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8 8 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path></svg>
          </button>
          <a class="ghost-button" href="/inquiry">Book Call</a>
          <a class="neon-button" href="/inquiry">Start Expansion <span>&rarr;</span></a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Toggle menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>
  </div>

  <slot />

  <div data-site-footer>
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="brand brand-premium" href="/"><span class="brand-mark"><img class="brand-avatar" src="/assets/images/flexist-avatar-192.png" alt="Flexist Logo" loading="lazy"><i></i></span><span class="brand-copy"><span class="wordmark gradient-text">Flexist</span><small>Web3 India Labs</small></span></a>
          <p class="footer-copy">India growth support for Web3 projects that want real users, active communities, and long-term trust.</p>
          <div class="social-links">
            <a class="social-icon" href="https://t.me/FlexistCrypto" target="_blank" rel="noreferrer" aria-label="Telegram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3 11.2l6.8 2.4L17 8.2l-5.4 6.8.2 5.1 3.1-3.5 4.2 3L21 4Z"></path></svg><span>Telegram</span>
            </a>
            <a class="social-icon" href="https://x.com/flexistcrypto" target="_blank" rel="noreferrer" aria-label="X">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 12.4 16H20L7.6 4H4Zm16 0-7.3 8.2M11.4 15.2 4 20"></path></svg><span>X</span>
            </a>
            <a class="social-icon" href="https://linktr.ee/FlexistWeb3" target="_blank" rel="noreferrer" aria-label="Linktree">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M7 8l5-5 5 5M7 16l5 5 5-5M4 12h16"></path></svg><span>Linktree</span>
            </a>
            <a class="social-icon" href="mailto:FlexistCrypto@gmail.com" aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4V6Zm0 0 8 7 8-7"></path></svg><span>Email</span>
            </a>
          </div>
        </div>
        <div>
          <h3 class="footer-title">Route Map</h3>
          <div class="footer-map">
            <div class="footer-group">
              <strong>Founder Journey</strong>
              <a href="/flexistlabs">FlexistLabs</a>
              <a href="/services">Growth Services</a>
              <a href="/plans">Plans & Pricing</a>
              <a href="/resources">Resources</a>
              <a href="/inquiry">Founder Inquiry</a>
            </div>
            <div class="footer-group">
              <strong>Platform</strong>
              <a href="/about">About Flexist</a>
              <a href="/experience">Experience</a>
              <a href="/contact">Contact</a>
            </div>
          </div>
        </div>
        <div>
          <h3 class="footer-title">Start Growing In India</h3>
          <p class="footer-copy">Receive focused Web3 growth notes and India market signals.</p>
          <form class="subscribe-form" data-subscribe-form>
            <input type="email" aria-label="Email address" placeholder="founder@project.xyz" required>
            <button type="submit">Join</button>
          </form>
          <div class="form-note" data-subscribe-note></div>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>&copy; {new Date().getFullYear()} Flexist</span>
        <span>Built for Web3 founders growing in India</span>
      </div>
    </footer>
  </div>

  <script is:inline defer src="/scripts/global.js"></script>
  <script is:inline defer src="/scripts/fx.js"></script>

  <Analytics />
  <SpeedInsights />
</body>
</html>
