---
import Layout from '../layouts/Layout.astro';
import '../styles/creators.css';
---

<Layout
  title="Creator Network | Join Flexist KOL Program"
  description="Monetize your Web3 influence. Connect with top crypto projects, receive direct briefs, and get paid in USDT/USDC. Join the Flexist Creator Network."
  canonical="https://flexist.in/creators"
  pageId="creators"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Flexist Creator Network",
    "description": "Web3 influencer and KOL partnership program",
    "url": "https://flexist.in/creators",
    "mainEntity": {
      "@type": "Service",
      "name": "Flexist Creator Network",
      "provider": {
        "@type": "Organization",
        "name": "Flexist",
        "url": "https://flexist.in"
      },
      "description": "Connect Web3 creators with crypto projects for paid campaigns"
    }
  }}
>
  <main id="main-content">
    <!-- Hero Section -->
    <section class="creators-hero">
      <div class="container">
        <div class="creators-hero-inner reveal">
          <p class="page-kicker">Flexist Creator Network | Web3 KOL Program</p>
          <h1>
            <span class="line">MONETIZE YOUR</span>
            <span class="line gradient-text">WEB3 INFLUENCE</span>
          </h1>
          <p class="creators-lede">
            Connect with leading Web3 protocols, token launches, and marketing campaigns.
            Receive targeted briefs, negotiate directly in Telegram, and get paid in crypto.
          </p>

          <div class="bot-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
            <span>Official Bot: <strong>@Flexist_kols_bot</strong></span>
          </div>

          <div class="creators-cta-row">
            <a href="https://t.me/Flexist_kols_bot?start=web_creators" target="_blank" rel="noopener noreferrer" class="telegram-button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              Join Creator Network on Telegram
            </a>
            <a href="#how-it-works" class="ghost-button">How It Works</a>
          </div>

          <div class="trust-row">
            <span class="trust-item">Verified Campaigns</span>
            <span class="trust-item">Direct Telegram Briefs</span>
            <span class="trust-item">USDT/Crypto Payouts</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Join Flexist -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Creator Value Proposition</span>
          <h2 class="section-title">Why Join Flexist</h2>
          <p>Built for Web3 creators who want real partnerships, not random gigs.</p>
        </div>

        <div class="value-grid">
          <article class="glass-card value-card reveal">
            <div class="value-icon">🎯</div>
            <h3>Targeted Campaign Matches</h3>
            <p>Get briefs tailored to your audience, platform, and Web3 niche. DeFi, Memes, GameFi, Infrastructure — we match you with projects that fit.</p>
          </article>

          <article class="glass-card value-card reveal">
            <div class="value-icon">⚡</div>
            <h3>Direct & Fast Briefs</h3>
            <p>No back-and-forth emails. Campaign offers and negotiations happen right in your Telegram chat. Fast responses, clear terms.</p>
          </article>

          <article class="glass-card value-card reveal">
            <div class="value-icon">💰</div>
            <h3>Reliable Payouts</h3>
            <p>Secure milestone compensation in USDT/USDC directly upon approved deliverables. No chasing invoices, no payment delays.</p>
          </article>

          <article class="glass-card value-card reveal">
            <div class="value-icon">🤝</div>
            <h3>Keep Your Independence</h3>
            <p>Freedom to set your own rate cards, accept or decline briefs without penalty. You control your partnerships.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Simple 4-Step Flow</span>
          <h2 class="section-title">How It Works</h2>
          <p>From sign-up to first payout in minutes, not weeks.</p>
        </div>

        <div class="steps-grid">
          <article class="glass-card step-card reveal">
            <h3>Open the Bot</h3>
            <p>Launch @Flexist_kols_bot on Telegram with one click. No app downloads, no complex forms.</p>
          </article>

          <article class="glass-card step-card reveal">
            <h3>Build Your Profile</h3>
            <p>Share your platform links (YouTube, X, TG, IG), niche, follower stats, and audience demographics.</p>
          </article>

          <article class="glass-card step-card reveal">
            <h3>Set Your Rates</h3>
            <p>Define your custom pricing for sponsored posts, dedicated videos, integrations, or reviews. You set the terms.</p>
          </article>

          <article class="glass-card step-card reveal">
            <h3>Receive Briefs & Get Paid</h3>
            <p>Review incoming client briefs, submit your deliverables, and receive timely payouts in crypto or stablecoins.</p>
          </article>
        </div>

        <div style="text-align: center; margin-top: 48px;" class="reveal">
          <a href="https://t.me/Flexist_kols_bot?start=web_creators" target="_blank" rel="noopener noreferrer" class="telegram-button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
            Get Started Now
          </a>
        </div>
      </div>
    </section>

    <!-- KOL Niches -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Niche Coverage</span>
          <h2 class="section-title">KOL Niches We Support</h2>
          <p>Whether you cover DeFi protocols or memecoin alpha, we have campaigns for you.</p>
        </div>

        <div class="niche-grid">
          <div class="niche-tag reveal">
            <span class="niche-emoji">🏛️</span>
            <span>DeFi & Protocols</span>
          </div>
          <div class="niche-tag reveal">
            <span class="niche-emoji">🐸</span>
            <span>Memecoins & Alpha</span>
          </div>
          <div class="niche-tag reveal">
            <span class="niche-emoji">🎮</span>
            <span>Gaming & Metaverse</span>
          </div>
          <div class="niche-tag reveal">
            <span class="niche-emoji">🎨</span>
            <span>NFTs & Collectibles</span>
          </div>
          <div class="niche-tag reveal">
            <span class="niche-emoji">📈</span>
            <span>Trading & TA</span>
          </div>
          <div class="niche-tag reveal">
            <span class="niche-emoji">⛓️</span>
            <span>L1/L2 Ecosystems</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Common Questions</span>
          <h2 class="section-title">Creator FAQ</h2>
        </div>

        <div class="creators-faq accordion reveal">
          <article class="accordion-item">
            <button class="accordion-toggle" type="button" aria-expanded="false">
              <span>How do I get verified?</span>
            </button>
            <div class="accordion-panel">
              <p>Profiles are reviewed by the Flexist team after submission in the bot. We verify your platform links, follower counts, and content quality to ensure you're matched with the right campaigns.</p>
            </div>
          </article>

          <article class="accordion-item">
            <button class="accordion-toggle" type="button" aria-expanded="false">
              <span>Does it cost anything to join?</span>
            </button>
            <div class="accordion-panel">
              <p>No. The Flexist Creator Network is 100% free for creators. You only earn — we never charge you to participate in campaigns.</p>
            </div>
          </article>

          <article class="accordion-item">
            <button class="accordion-toggle" type="button" aria-expanded="false">
              <span>What platforms are supported?</span>
            </button>
            <div class="accordion-panel">
              <p>We support YouTube, X (Twitter), Telegram channels, and Instagram. You can list multiple platforms in your profile to increase your campaign opportunities.</p>
            </div>
          </article>

          <article class="accordion-item">
            <button class="accordion-toggle" type="button" aria-expanded="false">
              <span>How do payouts work?</span>
            </button>
            <div class="accordion-panel">
              <p>Payouts are made in crypto or stablecoins (USDT/USDC) upon approved content deliverables. Once your content is approved by the client, payment is released directly to your wallet.</p>
            </div>
          </article>

          <article class="accordion-item">
            <button class="accordion-toggle" type="button" aria-expanded="false">
              <span>Can I decline campaigns?</span>
            </button>
            <div class="accordion-panel">
              <p>Absolutely. You have full control over which briefs you accept. Decline any campaign that doesn't fit your audience or brand — no penalties, no pressure.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Privacy & Security -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Your Security Matters</span>
          <h2 class="section-title">Privacy & Security Guarantee</h2>
        </div>

        <div class="security-banner reveal">
          <div class="shield-icon">🛡️</div>
          <div>
            <h3>Flexist Will Never Ask For</h3>
            <p>Private keys, seed phrases, wallet signatures, or any sensitive credentials. We only need your public wallet address for payouts.</p>
            <p>Your data is encrypted and never shared with third parties without your explicit consent.</p>
            <a href="https://flexist-bot.onrender.com/privacy" target="_blank" rel="noopener noreferrer">Read Privacy Policy →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section">
      <div class="container">
        <div class="cta-block reveal">
          <span class="section-label">Ready to Monetize?</span>
          <h2>Join 100+ Web3 Creators</h2>
          <p>Start receiving campaign briefs today. Set up your profile in under 5 minutes.</p>
          <div class="button-row" style="margin-top: 32px;">
            <a href="https://t.me/Flexist_kols_bot?start=web_creators" target="_blank" rel="noopener noreferrer" class="telegram-button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              Launch @Flexist_kols_bot
            </a>
            <a href="/services" class="ghost-button">Explore Services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Floating Mobile CTA -->
    <a href="https://t.me/Flexist_kols_bot?start=web_creators" target="_blank" rel="noopener noreferrer" class="floating-kol-cta" aria-label="Join Creator Network">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
      Join Network
    </a>
  </main>

  <script is:inline>
    // Accordion toggle for FAQ
    document.querySelectorAll('.creators-faq .accordion-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.accordion-item');
        const isOpen = item.classList.contains('open');

        // Close all items
        document.querySelectorAll('.creators-faq .accordion-item').forEach(i => {
          i.classList.remove('open');
          i.querySelector('.accordion-toggle').setAttribute('aria-expanded', 'false');
        });

        // Open clicked item if it wasn't already open
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</Layout>
