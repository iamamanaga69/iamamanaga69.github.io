---
import Layout from '../layouts/Layout.astro';
import '../styles/inquiry.css';
---

<Layout
  title="Founder Inquiry | Flexist"
  description="Tell Flexist about your Web3 project and get a clear first step for India growth."
  canonical="https://flexist.in/inquiry"
  pageId="inquiry"
>
  <main id="main-content">
    <!-- Sticky step progress bar -->
    <div class="sticky-progress-bar" id="stickyProgressBar">
      <div class="progress-bar-container">
        <div class="progress-bar-text">
          <span class="progress-step-num" id="stickyProgressStep">Step 1 of 7</span>
          <span class="progress-step-divider">&mdash;</span>
          <span class="progress-step-name" id="stickyProgressName">Project Details</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="stickyProgressFill"></div>
        </div>
      </div>
    </div>

    <section class="page-hero"><div class="container page-hero-content"><p class="page-kicker">Founder Inquiry | Start The India Plan</p><h1 class="page-title">TELL US ABOUT<br><span class="gradient-text">YOUR PROJECT.</span></h1><p class="page-lede">Answer a few quick questions. We'll get your project stage, India goal, current community, budget, and where you need help first.</p></div></section>

    <section class="section"><div class="container inquiry-layout">
      <div class="terminal-box inquiry-terminal" id="inquiryTerminal">
        <div class="terminal-topbar">
          <span class="terminal-dot red"></span><span class="terminal-dot yellow"></span><span class="terminal-dot green"></span>
          <span class="terminal-path">Founder inquiry form <span class="cursor">_</span></span>
        </div>
        <div class="inquiry-progress" data-inquiry-progress>
          <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
          <span class="progress-label" id="progressLabel">Step 1 / 7</span>
        </div>
        <!-- UX Overhaul: Estimated time indicator -->
        <div class="form-est-time" id="formEstTime">🕒 Takes about 3 minutes</div>

        <form class="inquiry-steps" id="inquirySteps" data-inquiry-engine>
          <section class="inquiry-step active" data-step="1">
            <div class="step-label">Step 1 - Project Details</div>
            <h2 class="step-heading">Tell us about the project.</h2>
            <div class="field-grid">
              <div class="field"><label for="projectName">Project name</label><input id="projectName" name="projectName" required placeholder="Project name"></div>
              <div class="field"><label for="projectUrl">Website URL</label><input id="projectUrl" name="projectUrl" type="url" placeholder="https://project.xyz"></div>
              <div class="field"><label for="projectChain">Blockchain</label><select id="projectChain" name="chain"><option value="">Select blockchain</option><option value="ethereum">Ethereum</option><option value="solana">Solana</option><option value="bnb">BNB Chain</option><option value="base">Base</option><option value="polygon">Polygon</option><option value="other">Other</option></select></div>
              <div class="field"><label for="projectCategory">Category</label><select id="projectCategory" name="category"><option value="">Project category</option><option value="defi">DeFi</option><option value="gamefi">GameFi</option><option value="nft">NFT</option><option value="infra">Infrastructure</option><option value="wallet">Wallet</option><option value="exchange">Exchange / DEX</option><option value="other">Other</option></select></div>
            </div>
          </section>

          <section class="inquiry-step" data-step="2">
            <div class="step-label">Step 2 - Stage And Funding</div>
            <h2 class="step-heading">What stage is the project at?</h2>
            <div class="option-grid">
              <button class="option-card" type="button" data-field="stage" data-value="bootstrapped">Bootstrapped</button>
              <button class="option-card" type="button" data-field="stage" data-value="preseed">Pre-seed</button>
              <button class="option-card" type="button" data-field="stage" data-value="seed">Seed</button>
              <button class="option-card" type="button" data-field="stage" data-value="seriesa">Series A</button>
              <button class="option-card" type="button" data-field="stage" data-value="public">Token launched</button>
              <button class="option-card" type="button" data-field="stage" data-value="scaling">Scaling ecosystem</button>
            </div>
            <div class="field spaced"><label for="launchStatus">Launch status</label><select id="launchStatus" name="launchStatus"><option value="">Launch status</option><option value="prelaunched">Not yet launched</option><option value="soft">Soft launch</option><option value="live">Live product</option></select></div>
          </section>

          <section class="inquiry-step" data-step="3">
            <div class="step-label">Step 3 - Current Community</div>
            <h2 class="step-heading">Where is your community today?</h2>
            <div class="field-grid">
              <div class="field"><label for="telegramSize">Telegram members</label><select id="telegramSize"><option value="0">No Telegram</option><option value="1">Under 500</option><option value="2">500 - 5K</option><option value="3">5K - 50K</option><option value="4">50K+</option></select></div>
              <div class="field"><label for="discordSize">Discord members</label><select id="discordSize"><option value="0">No Discord</option><option value="1">Under 1K</option><option value="2">1K - 10K</option><option value="3">10K+</option></select></div>
              <div class="field"><label for="twitterSize">Twitter / X followers</label><select id="twitterSize"><option value="0">No presence</option><option value="1">Under 1K</option><option value="2">1K - 10K</option><option value="3">10K - 100K</option><option value="4">100K+</option></select></div>
              <div class="field"><label for="totalUsers">Users / holders</label><select id="totalUsers"><option value="0">Under 1,000</option><option value="1">1K - 10K</option><option value="2">10K - 100K</option><option value="3">100K+</option></select></div>
            </div>
          </section>

          <section class="inquiry-step" data-step="4">
            <div class="step-label">Step 4 - India Goals</div>
            <h2 class="step-heading">What does success in India look like?</h2>
            <div class="field"><label for="indiaTarget">Target Indian users in 6 months</label><input id="indiaTarget" type="number" min="0" placeholder="100000"></div>
            <div class="checkbox-group"><p class="field-label">Priority platforms</p><label><input type="checkbox" value="telegram" class="india-platform"> 💬 Telegram</label><label><input type="checkbox" value="youtube" class="india-platform"> 📺 YouTube</label><label><input type="checkbox" value="twitter" class="india-platform"> 𝕏 Twitter / X</label><label><input type="checkbox" value="discord" class="india-platform"> 👾 Discord</label></div>
          </section>

          <section class="inquiry-step" data-step="5">
            <div class="step-label">Step 5 - Budget And Timeline</div>
            <h2 class="step-heading">What resources are available?</h2>
            <div class="option-grid two-col">
              <button class="option-card" type="button" data-field="budget" data-value="sub1k">Under $1K/mo</button>
              <button class="option-card" type="button" data-field="budget" data-value="1to5k">$1K - $5K/mo</button>
              <button class="option-card" type="button" data-field="budget" data-value="5to20k">$5K - $20K/mo</button>
              <button class="option-card" type="button" data-field="budget" data-value="20kplus">$20K+/mo</button>
            </div>
            <div class="field spaced"><label for="launchUrgency">India launch timing</label><select id="launchUrgency"><option value="">India launch timing</option><option value="1month">Within 1 month</option><option value="3months">1 - 3 months</option><option value="6months">3 - 6 months</option><option value="flexible">Flexible</option></select></div>
          </section>

          <section class="inquiry-step" data-step="6">
            <div class="step-label">Step 6 - Support Needed</div>
            <h2 class="step-heading">What help do you need from Flexist?</h2>
            <div class="checkbox-grid">
              <label><input type="checkbox" value="community" class="service-select"> 🏗️ Community Building</label>
              <label><input type="checkbox" value="expansion" class="service-select"> 🇮🇳 India Expansion</label>
              <label><input type="checkbox" value="kol" class="service-select"> 📢 KOL Campaigns</label>
              <label><input type="checkbox" value="ambassador" class="service-select"> 🤝 Ambassador Program</label>
              <label><input type="checkbox" value="partnerships" class="service-select"> 💼 Partnerships</label>
              <label><input type="checkbox" value="consulting" class="service-select"> 📈 Growth Consulting</label>
            </div>
          </section>

          <section class="inquiry-step" data-step="7">
            <div class="step-label">Step 7 - Founder Contact</div>
            <h2 class="step-heading">Where should Flexist reply?</h2>
            <div class="field-grid"><div class="field"><label for="founderName">Founder name</label><input id="founderName" required placeholder="Your name"></div><div class="field"><label for="founderEmail">Email</label><input id="founderEmail" type="email" required placeholder="founder@project.xyz"></div><div class="field"><label for="founderTelegram">Telegram</label><input id="founderTelegram" placeholder="@username"></div></div>
            <div class="field"><label for="founderContext">Context</label><textarea id="founderContext" rows="5" placeholder="Share traction, launch goals, blockers, and the exact India outcome you want."></textarea></div>
          </section>

          <div class="step-nav"><button class="ghost-button" type="button" data-back>Back</button><button class="neon-button" type="button" data-next>Continue</button></div>
          <p class="form-note" data-inquiry-note></p>
        </form>

        <section class="inquiry-ticket" id="inquiryTicket" hidden>
          <div class="ticket-header"><span class="tag-chip signal">Inquiry Ticket</span><strong id="ticketId">FC-0000</strong></div>
          <div class="ticket-score">
            <div class="score-gauge">
              <i id="scoreGaugeFill" style="display: none;"></i>
              <svg class="circular-gauge" viewBox="0 0 100 100">
                <defs>
                  <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="var(--accent-blue)" />
                    <stop offset="100%" stop-color="var(--accent-green)" />
                  </linearGradient>
                </defs>
                <circle class="gauge-bg" cx="50" cy="50" r="40" />
                <circle class="gauge-fill" cx="50" cy="50" r="40" id="gaugeCircleFill" />
              </svg>
              <span id="scoreNumber">0/100</span>
            </div>
          </div>
          <div class="ticket-grid">
            <div><span>Project</span><strong id="ticketProject">-</strong></div>
            <div><span>Chain</span><strong id="ticketChain">-</strong></div>
            <div><span>Stage</span><strong id="ticketStage">-</strong></div>
            <div><span>India Target</span><strong id="ticketTarget">-</strong></div>
            <div><span>Budget</span><strong id="ticketBudget">-</strong></div>
            <div><span>Services</span><strong id="ticketServices">-</strong></div>
          </div>
          <div class="recommendation-grid ticket-insights">
            <article class="glass-card recommendation"><h4>Strengths</h4><ul id="strengthsList"></ul></article>
            <article class="glass-card recommendation"><h4>Gaps</h4><ul id="gapsList"></ul></article>
            <article class="glass-card recommendation"><h4>Next Actions</h4><ul id="actionsList"></ul></article>
          </div>
          <div class="button-row" id="ticketButtonRow" style="display: flex; flex-direction: column; gap: 12px; width: 100%; margin-top: 24px;">
            <div style="display: flex; gap: 12px; flex-wrap: wrap; width: 100%;">
              <a class="neon-button" id="ticketDiscussTelegram" href="#" target="_blank" style="flex: 1; min-width: 200px; text-align: center;">Discuss with Flexist (Auto Group)</a>
              <a class="ghost-button" id="ticketDirectTelegram" href="https://t.me/FlexistCrypto" target="_blank" style="flex: 1; min-width: 200px; text-align: center; border-color: rgba(255,255,255,0.1);">Direct Founder Chat (t.me/FlexistCrypto)</a>
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap; width: 100%;">
              <a class="ghost-button" id="ticketEmail" href="mailto:FlexistCrypto@gmail.com" style="flex: 1; min-width: 200px; text-align: center;">Send Details By Email</a>
              <a class="ghost-button" href="/contact" style="flex: 1; min-width: 200px; text-align: center;">Open Contact Page</a>
            </div>
          </div>
        </section>
      </div>

      <aside class="inquiry-aside"><article class="glass-card"><span class="tag-chip signal">Result</span><h3>India Score</h3><p>Based on your community, budget, timing, and the kind of support you need.</p></article><article class="glass-card"><span class="tag-chip">Summary</span><h3>Founder Context</h3><p>Creates a simple summary of your project and the next steps we'd recommend.</p></article><article class="glass-card"><span class="tag-chip">Next</span><h3>Founder Conversation</h3><p>The email button sends your details straight into a direct founder chat.</p></article></aside>
    </div></section>
  </main>

  <script is:inline src="/scripts/inquiry.js"></script>
</Layout>
