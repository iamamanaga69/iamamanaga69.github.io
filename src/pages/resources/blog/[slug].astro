---
import Layout from '../../../layouts/Layout.astro';
import blogArticles from '../../../data/blogArticles.json';

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const related = blogArticles
  .filter((item) => item.cluster === article.cluster && item.slug !== article.slug)
  .slice(0, 3);
const canonical = `https://flexist.in/resources/blog/${article.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.datePublished || '2026-09-01',
  dateModified: article.dateModified || '2026-09-11',
  image: article.image || 'https://flexist.in/assets/images/flexist-og.png',
  author: { '@type': 'Organization', name: 'Flexist' },
  publisher: {
    '@type': 'Organization',
    name: 'Flexist',
    logo: { '@type': 'ImageObject', url: 'https://flexist.in/assets/images/flexist-avatar-192.png' }
  },
  mainEntityOfPage: canonical
};

// Simple markdown-to-HTML converter (handles H2, H3, paragraphs, lists, bold, links)
function renderMarkdown(md: string): string {
  if (!md) return '';
  let html = md;
  // Headings
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  // Bold
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  // Links
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  // Unordered lists
  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
  html = html.replace(/((?:<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>');
  // Ordered lists
  html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  // Paragraphs (double newline)
  html = html.replace(/\n\n/g, '</p><p>');
  html = '<p>' + html + '</p>';
  // Clean up empty paragraphs and fix nesting
  html = html.replace(/<p>\s*<\/p>/g, '');
  html = html.replace(/<p>\s*(<h[23]>)/g, '$1');
  html = html.replace(/(<\/h[23]>)\s*<\/p>/g, '$1');
  html = html.replace(/<p>\s*(<ul>)/g, '$1');
  html = html.replace(/(<\/ul>)\s*<\/p>/g, '$1');
  return html;
}
---

<Layout
  title={`${article.title} | Flexist`}
  description={article.description}
  canonical={canonical}
  pageId="resources"
  schema={articleSchema}
  ogType="article"
  publishedTime={article.datePublished}
  modifiedTime={article.dateModified}
>
  <main id="main-content">
    <article>
      <section class="page-hero">
        <div class="container page-hero-content">
          <p class="page-kicker">{article.cluster}</p>
          <h1 class="page-title">{article.title}</h1>
          <p class="page-lede">{article.intro}</p>
          <div class="article-meta">
            <span class="meta-item">By Flexist Team</span>
            <span class="meta-sep">·</span>
            <span class="meta-item">{article.datePublished || 'Sep 2026'}</span>
            <span class="meta-sep">·</span>
            <span class="meta-item">{Math.ceil((article.body || '').split(/\s+/).length / 200)} min read</span>
          </div>
          <div class="button-row">
            <a class="neon-button" href={`/services/${article.service}`}>Relevant Service</a>
            <a class="ghost-button" href="/inquiry">Ask Flexist</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container split-layout">
          <div class="manifesto-copy reveal blog-body">
            {article.body ? (
              <Fragment set:html={renderMarkdown(article.body)} />
            ) : (
              <Fragment>
                <h2>What founders should understand first.</h2>
                <p>{article.intro}</p>
                <p>For Web3 projects, growth does not start when a post goes live. It starts when the user has enough context to trust the project, ask a good question, and take the next step.</p>
              </Fragment>
            )}
          </div>
          <aside class="glass-card reveal">
            <span class="section-label">Related Reading</span>
            <ul class="value-list">
              {related.map((item) => <li><a href={`/resources/blog/${item.slug}`}>{item.title}</a></li>)}
            </ul>
            <a class="ghost-button" href="/resources/blog">All Blog Articles</a>
          </aside>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="cta-block reveal">
            <h2>Want this applied to your project?</h2>
            <p>Share your category, stage, current community, and India goal. Flexist will help map the next move.</p>
            <div class="button-row">
              <a class="neon-button" href="/inquiry">Open Founder Inquiry</a>
              <a class="ghost-button" href={`/services/${article.service}`}>View Related Service</a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>
</Layout>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .meta-sep {
    color: var(--accent-cyan);
    opacity: 0.5;
  }
  .blog-body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 2rem);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .blog-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.5vw, 1.5rem);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .blog-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  .blog-body ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .blog-body li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .blog-body strong {
    color: var(--accent-cyan);
    font-weight: 600;
  }
  .blog-body a {
    color: var(--accent-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-body a:hover {
    color: var(--accent-blue);
  }
</style>
