---
import Layout from '../../layouts/Layout.astro';
import blogArticles from '../../data/blogArticles.json';

const clusters = [...new Set(blogArticles.map((article) => article.cluster))];
---

<Layout
  title="Web3 Growth Resources India | Flexist"
  description="Guides, blog articles, and case-study resources on Web3 marketing, Telegram community growth, KOL campaigns, and India market entry."
  canonical="https://flexist.in/resources"
  pageId="resources"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container page-hero-content">
        <p class="page-kicker">Resources</p>
        <h1 class="page-title">Web3 Growth Resources<br><span class="gradient-text">for India Expansion</span></h1>
        <p class="page-lede">Founder-friendly guides on Telegram marketing, India Web3 market entry, KOL campaigns, ambassador programs, and community-led growth.</p>
      </div>
    </section>
    <section class="section">
      <div class="container grid-3">
        {clusters.map((cluster) => (
          <article class="glass-card reveal">
            <span class="section-label">{cluster}</span>
            <h2>{cluster}</h2>
            <p>Read practical notes and playbooks for this topic cluster.</p>
            <a class="ghost-button" href="/resources/blog">Open Blog</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
