---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
import '../styles/about.css';
---

<Layout
  title="About Us | Flexist"
  description="Flexist helps Web3 projects enter India with community support, creator campaigns, ambassadors, partnerships, and clear growth plans."
  canonical="https://flexist.in/about"
  pageId="about"
>
  <main id="main-content">
    <section class="page-hero"><div class="container page-hero-content"><p class="page-kicker">About Flexist | India Growth Partner</p><h1 class="page-title">WEB3 PROJECTS<br><span class="gradient-text">GROW IN INDIA.</span></h1><p class="page-lede">Flexist helps founders enter India with a clear plan, trusted community support, local creators, ambassadors, and useful partnerships.</p></div></section>
    
    <section class="section"><div class="container split-layout">
      <div class="manifesto-copy reveal">
        <span class="section-label">Origin Story</span>
        <h2 class="section-title">{aboutData.manifesto_title}</h2>
        {aboutData.manifesto_copy.map((p) => <p>{p}</p>)}
      </div>
      <div class="terminal-box reveal">
        <div class="terminal-head"><span>Flexist Mission</span><span class="terminal-status">Clear</span></div>
        <p><span class="terminal-prompt">Mission</span> {aboutData.mission}</p>
        <p><span class="terminal-prompt">Vision</span> {aboutData.vision}</p>
        <p><span class="terminal-prompt">Values</span> {aboutData.values}</p>
      </div>
    </div></section>
    
    <section class="section section-dark"><div class="container"><div class="section-header reveal"><span class="section-label">Market Opportunity</span><h2 class="section-title">India is not one simple audience.</h2><p>Users discover projects through Telegram, X, YouTube, regional voices, friends, and trusted communities. Strong launches connect these places instead of spending on random attention.</p></div><div class="grid-4"><div class="glass-card mini-stat reveal"><strong>100M+</strong><span>Market Potential</span></div><div class="glass-card mini-stat reveal"><strong>24/7</strong><span>Community Rhythm</span></div><div class="glass-card mini-stat reveal"><strong>4</strong><span>Main Growth Channels</span></div><div class="glass-card mini-stat reveal"><strong>1</strong><span>India Growth Partner</span></div></div></div></section>
    
    <section class="section"><div class="container"><div class="section-header reveal"><span class="section-label">Positioning</span><h2 class="section-title">This is more than basic community work.</h2></div><div class="compare-grid">
      <article class="glass-card compare-card negative reveal"><h3>What We Are Not</h3><ul class="value-list"><li>Community manager for hire</li><li>Reactive chat moderator</li><li>Generic freelancer</li><li>Social media executive</li></ul></article>
      <article class="glass-card compare-card positive reveal"><h3>What We Are</h3><ul class="value-list"><li>India growth partner</li><li>Community builder</li><li>Creator campaign planner</li><li>Expansion support for Web3 founders</li></ul></article>
    </div></div></section>
    
    <section class="section section-dark"><div class="container"><div class="section-header reveal"><span class="section-label">Core Capabilities</span><h2 class="section-title">The work behind the growth.</h2></div><div class="accordion">
      <article class="accordion-item"><button class="accordion-toggle" type="button" aria-expanded="false">Community Building</button><div class="accordion-panel"><p>We build Telegram and Discord communities that reply fast, stay active, stay well-moderated, and turn members into real users.</p></div></article>
      <article class="accordion-item"><button class="accordion-toggle" type="button" aria-expanded="false">India Market Entry</button><div class="accordion-panel"><p>We turn your goals into a clear India launch plan — the right channels, the right creators, and simple growth targets you can actually hit.</p></div></article>
      <article class="accordion-item"><button class="accordion-toggle" type="button" aria-expanded="false">Creator Campaigns</button><div class="accordion-panel"><p>We pick creators by how much their audience trusts them, how they behave on each platform, and whether they fit your goal — not just follower count.</p></div></article>
      <article class="accordion-item"><button class="accordion-toggle" type="button" aria-expanded="false">Ambassador Programs</button><div class="accordion-panel"><p>We recruit and manage advocates with clear tasks, training, incentives, and regular progress updates.</p></div></article>
      <article class="accordion-item"><button class="accordion-toggle" type="button" aria-expanded="false">Partnership Development</button><div class="accordion-panel"><p>We build real relationships with other projects, communities, and partners that keep users coming in.</p></div></article>
    </div></div></section>
    
    <section class="section section-dark"><div class="container split-layout"><div class="reveal"><span class="section-label">Skill Set & Philosophy</span><h2 class="section-title">Skills shaped for fast-moving Web3 teams.</h2><p>We pair community building and local know-how with real commercial sense. We work remote-first, follow the data, and build for long-term trust — not short-term attention spikes.</p><div class="chip-row" style="margin-top:20px"><span class="tag-chip">AI-Integrated Workflow</span><span class="tag-chip">Community Support</span><span class="tag-chip">Partnership Ops</span><span class="tag-chip">Local Hinglish Advocacy</span><span class="tag-chip">Cost Discipline</span></div></div><div class="language-row reveal"><div class="language-item"><span>English</span><div class="proficiency"><i class="level-96"></i></div><span>Fluent</span></div><div class="language-item"><span>Turkish</span><div class="proficiency"><i class="level-92"></i></div><span>Fluent</span></div><div class="language-item"><span>Vietnamese</span><div class="proficiency"><i class="level-64"></i></div><span>Written</span></div><div class="language-item"><span>Hinglish</span><div class="proficiency"><i class="level-100"></i></div><span>Native</span></div></div></div></section>

    <section class="section"><div class="container"><div class="section-header reveal"><span class="section-label">Founder Credentials</span><h2 class="section-title">Commercial foundation. Practical growth instincts.</h2></div><div class="grid-2"><article class="glass-card credential reveal" style="padding: 24px;"><small>Bachelor of Commerce</small><h3>Xavier's University</h3><p>Business fundamentals, commercial thinking, and a structured approach to growth decisions.</p></article><article class="glass-card credential reveal" style="padding: 24px;"><small>Cost & Management Accountancy - Pursuing</small><h3>ICMAI</h3><p>Management accounting discipline applied to running lean and measuring what actually works.</p></article></div></div></section>

    <section class="section section-dark"><div class="container"><div class="cta-block reveal"><span class="section-label">Start The India Plan</span><h2>India is too large for generic growth.</h2><p>Build a local plan around how users discover, evaluate, and join Web3 projects.</p><div class="button-row"><a class="neon-button" href="/inquiry">Book Strategy Call</a><a class="ghost-button" href="/flexistlabs">Open FlexistLabs</a></div></div></div></section>
  </main>

  <script is:inline src="/scripts/about.js"></script>
</Layout>
