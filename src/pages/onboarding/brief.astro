---
import Layout from '../../layouts/Layout.astro';
import '../../styles/onboarding.css';
---

<Layout
  title="Project Briefing | FLEXIST"
  description="Submit your FLEXIST project brief — tell us about your project so we can build your India growth strategy."
  canonical="https://flexist.in/onboarding/brief"
  pageId="onboarding"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Syne:wght@600;700&display=swap" rel="stylesheet">
  </Fragment>

  <main id="main-content">
    <!-- Hero -->
    <section class="brief-hero">
      <div class="container" style="position:relative;z-index:1">
        <span class="page-kicker">// project brief</span>
        <h1 class="page-title gradient-text" style="font-size:clamp(2.8rem,7vw,5.5rem)">Tell Us About<br>Your Project.</h1>
        <p class="page-lede">This brief helps us craft a custom India growth strategy. The more detail you provide, the faster we can start executing.</p>
      </div>
    </section>

    <!-- Brief Form -->
    <section class="section" style="padding-top:24px">
      <div class="container" style="max-width:780px">
        <form id="briefForm">
          <!-- Section 1: Project Identity -->
          <div class="form-section reveal">
            <div class="form-section-head">
              <span><span class="terminal-prompt">$</span> project_identity</span>
              <span>01/05</span>
            </div>
            <div class="form-section-body">
              <div class="form-grid-2">
                <div class="field">
                  <label for="project_name">Project Name *</label>
                  <input type="text" id="project_name" name="project_name" placeholder="e.g. Phantom Wallet" required>
                </div>
                <div class="field">
                  <label for="website">Website</label>
                  <input type="url" id="website" name="website" placeholder="https://yourproject.xyz">
                </div>
              </div>
              <div class="form-grid-2">
                <div class="field">
                  <label for="blockchain">Blockchain *</label>
                  <select id="blockchain" name="blockchain" required>
                    <option value="">Select blockchain…</option>
                    <option>Ethereum</option>
                    <option>BNB Chain</option>
                    <option>Solana</option>
                    <option>Polygon</option>
                    <option>Avalanche</option>
                    <option>Arbitrum</option>
                    <option>Optimism</option>
                    <option>Base</option>
                    <option>TON</option>
                    <option>Cosmos</option>
                    <option>Multi-chain</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="token_ticker">Token Ticker</label>
                  <input type="text" id="token_ticker" name="token_ticker" placeholder="e.g. $FLEX">
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: Growth Context -->
          <div class="form-section reveal">
            <div class="form-section-head">
              <span><span class="terminal-prompt">$</span> growth_context</span>
              <span>02/05</span>
            </div>
            <div class="form-section-body">
              <div class="form-grid-2">
                <div class="field">
                  <label for="current_users">Current Total Users</label>
                  <input type="text" id="current_users" name="current_users" placeholder="e.g. 12,000">
                </div>
                <div class="field">
                  <label for="tg_size">Telegram Community Size</label>
                  <input type="text" id="tg_size" name="tg_size" placeholder="e.g. 3,500">
                </div>
              </div>
              <div class="field">
                <label for="target_india">Target India Users in 6 Months</label>
                <input type="text" id="target_india" name="target_india" placeholder="e.g. 25,000 active users">
              </div>
            </div>
          </div>

          <!-- Section 3: Campaign Goals -->
          <div class="form-section reveal">
            <div class="form-section-head">
              <span><span class="terminal-prompt">$</span> campaign_goals</span>
              <span>03/05</span>
            </div>
            <div class="form-section-body">
              <label style="color:var(--text-muted);font-family:var(--font-mono);font-size:0.66rem;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px">Select all that apply</label>
              <div class="checkbox-grid">
                <label class="check-option">
                  <input type="checkbox" name="goals" value="User Acquisition">
                  <span>User Acquisition</span>
                </label>
                <label class="check-option">
                  <input type="checkbox" name="goals" value="Community Building">
                  <span>Community Building</span>
                </label>
                <label class="check-option">
                  <input type="checkbox" name="goals" value="Influencer Campaigns">
                  <span>Influencer Campaigns</span>
                </label>
                <label class="check-option">
                  <input type="checkbox" name="goals" value="Ambassador Program">
                  <span>Ambassador Program</span>
                </label>
                <label class="check-option">
                  <input type="checkbox" name="goals" value="Exchange Listings">
                  <span>Exchange Listings</span>
                </label>
                <label class="check-option">
                  <input type="checkbox" name="goals" value="Partnership Network">
                  <span>Partnership Network</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Section 4: Timeline & Budget -->
          <div class="form-section reveal">
            <div class="form-section-head">
              <span><span class="terminal-prompt">$</span> timeline_budget</span>
              <span>04/05</span>
            </div>
            <div class="form-section-body">
              <div class="form-grid-2">
                <div class="field">
                  <label for="timeline">Launch Timeline</label>
                  <select id="timeline" name="timeline">
                    <option value="">Select timeline…</option>
                    <option>Already launched</option>
                    <option>Launching in 1-2 weeks</option>
                    <option>Launching in 1 month</option>
                    <option>Launching in 2-3 months</option>
                    <option>Launching in 3+ months</option>
                  </select>
                </div>
                <div class="field">
                  <label for="budget">Monthly Budget for India</label>
                  <select id="budget" name="budget">
                    <option value="">Select budget range…</option>
                    <option>Under $500/mo</option>
                    <option>$500 – $1,000/mo</option>
                    <option>$1,000 – $2,000/mo</option>
                    <option>$2,000 – $5,000/mo</option>
                    <option>$5,000+/mo</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 5: Additional Notes -->
          <div class="form-section reveal">
            <div class="form-section-head">
              <span><span class="terminal-prompt">$</span> additional_notes</span>
              <span>05/05</span>
            </div>
            <div class="form-section-body">
              <div class="field">
                <label for="notes">Anything else we should know?</label>
                <textarea id="notes" name="notes" rows="5" placeholder="Previous India activity, specific requirements, special context…"></textarea>
              </div>
            </div>
          </div>

          <!-- Submit -->
          <div class="button-row reveal" style="margin-top:8px">
            <button class="neon-button" type="submit" style="width:100%;justify-content:center;padding:16px">Submit Project Brief →</button>
          </div>
        </form>

        <!-- Success State -->
        <div class="form-success" id="briefSuccess" style="display:none">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <h2 class="gradient-text">Brief Submitted!</h2>
          <p>We've received your project details. Redirecting you to your portal in a moment…</p>
        </div>
      </div>
    </section>
  </main>

  <script src="../../scripts/onboarding.js"></script>
</Layout>
