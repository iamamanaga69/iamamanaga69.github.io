---
import Layout from '../../layouts/Layout.astro';
import '../../styles/payment.css';
---

<Layout
  title="Secure Payment | FLEXIST"
  description="Complete your crypto payment to FLEXIST. Multi-chain support: Ethereum, BNB Chain, Polygon, Solana, Base, Arbitrum, TRON."
  canonical="https://flexist.in/payment"
  pageId="payment"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Syne:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <main id="main-content">

    <!-- HERO -->
    <section class="page-hero">
      <div class="container page-hero-content">
        <span class="page-kicker">// secure crypto payment</span>
        <h1 class="page-title">Complete Your <span class="gradient-text">Payment</span></h1>
        <p class="page-lede" id="pay-hero-plan"></p>
      </div>
    </section>

    <!-- PAYMENT FLOW -->
    <section class="section">
      <div class="container">

        <!-- Fallback if no plan is selected -->
        <div class="no-plan-fallback" id="no-plan-fallback" hidden>
          <div class="fallback-card">
            <span class="fallback-icon">ðŸ›’</span>
            <h2>No Plan Selected</h2>
            <p>To proceed with a payment, please choose one of our growth plans first. If you need a custom invoice or package, please contact our support team.</p>
            <div class="fallback-actions">
              <a href="/plans" class="neon-button">View Growth Plans</a>
              <a href="https://t.me/FlexistCrypto" target="_blank" class="ghost-button">Contact Support (Telegram)</a>
            </div>
          </div>
        </div>

        <div class="checkout-layout-grid">

          <!-- Left Column: Payment Steps -->
          <div class="checkout-main-col">
            
            <!-- Trust Banner -->
            <div class="payment-trust-banner reveal">
              <span class="trust-icon">🔒</span>
              <p class="trust-text">All payments are <strong>verified directly on-chain</strong> using secure blockchain infrastructure. Your funds are protected by cryptographic verification at every step.</p>
            </div>

            <!-- Step Indicator -->
            <div class="pay-steps reveal">
              <div class="pay-step active" data-step="1">
                <span class="pay-step-dot">1</span>
                <span class="pay-step-label">Select Chain</span>
                <span class="pay-step-sub">Choose network</span>
              </div>
              <div class="pay-step-line" data-after="1"></div>
              <div class="pay-step" data-step="2">
                <span class="pay-step-dot">2</span>
                <span class="pay-step-label">Send Payment</span>
                <span class="pay-step-sub">Transfer funds</span>
              </div>
              <div class="pay-step-line" data-after="2"></div>
              <div class="pay-step" data-step="3">
                <span class="pay-step-dot">3</span>
                <span class="pay-step-label">Confirm</span>
                <span class="pay-step-sub">Verify & complete</span>
              </div>
            </div>

            <!-- STEP 1: Select Chain -->
            <div class="pay-panel reveal" id="step-1">
              <h2 class="pay-panel-title">
                <span class="step-num">1</span>
                Select Your Network
              </h2>
              <p class="pay-panel-sub">Choose the blockchain network you'll use to send payment. All chains lead to the same FLEXIST wallet.</p>

              <!-- Checkout Path Selector -->
              <div class="checkout-paths">
                <!-- Path A: Automated Web Checkout -->
                <div class="path-card active" id="path-automated">
                  <div class="path-card-title">
                    <span>âš¡</span>
                    <strong>Instant Web Checkout</strong>
                  </div>
                  <p class="path-card-desc">Pay automatically with major cryptocurrencies and verify transaction instantly on-chain.</p>
                </div>
                
                <!-- Path B: Private Telegram Coordination -->
                <a href="https://t.me/FlexistCrypto" target="_blank" class="path-card" id="path-private">
                  <div class="path-card-title">
                    <span>ðŸ’¬</span>
                    <strong>Deal Privately (Telegram)</strong>
                  </div>
                  <p class="path-card-desc">Coordinate privately with @FlexistCrypto, customize terms, or pay with other methods.</p>
                </a>
              </div>

              <div class="chain-grid" id="chain-grid">
                <!-- Rendered by JS -->
              </div>
            </div>

            <!-- STEP 2: Send Payment -->
            <div class="pay-panel" id="step-2" hidden>
              <h2 class="pay-panel-title">
                <span class="step-num">2</span>
                Send Your Payment
              </h2>
              <p class="pay-panel-sub">Send the exact amount to the wallet address below using your selected network.</p>

              <!-- Wallet Address Terminal -->
              <div class="wallet-display">
                <div class="wallet-head">
                  <span class="wallet-head-label">Wallet Address</span>
                  <span class="wallet-head-chain" id="wallet-chain">â— Network</span>
                </div>
                <div class="wallet-body">
                  <code class="wallet-address" id="wallet-addr">â€”</code>
                  <button class="copy-btn" type="button" id="copy-wallet">â§‰ Copy</button>
                </div>
              </div>

              <!-- QR Code -->
              <div class="qr-frame">
                <span class="qr-label">Scan to pay</span>
                <div id="qr-container"></div>
              </div>

              <!-- Network Warning -->
              <div class="network-warning">
                <strong>âš  Network Warning</strong>
                <p>Only send tokens on the <strong id="warning-chain">â€”</strong> network. Tokens sent on the wrong network may be permanently lost. Double-check the chain before confirming.</p>
              </div>

              <!-- Action Row -->
              <div class="pay-action-row">
                <button class="ghost-button" type="button" data-back="1">â† Back</button>
                <button class="btn-sent" type="button" id="btn-sent">I Have Sent the Payment â†’</button>
              </div>
            </div>

            <!-- STEP 3: Confirm -->
            <div class="pay-panel" id="step-3" hidden>
              <h2 class="pay-panel-title">
                <span class="step-num">3</span>
                Confirm Your Payment
              </h2>

              <form class="pay-form" id="pay-form">
                <!-- PART A: VERIFY TRANSACTION HASH -->
                <div id="form-part-verification">
                  <p class="pay-panel-sub" style="margin-bottom: 20px;">Provide your transaction details to verify your payment directly on-chain first.</p>

                  <!-- Redesigned Verification Tip Alert -->
                  <div class="verification-advice-box">
                    <strong>ðŸ”’ SECURED PAYMENT VERIFICATION</strong>
                    <p>If your transaction is not verifying immediately, do not worry! Please try to verify the transaction hash after <strong>10â€“15 block confirmations</strong> or about <strong>5 minutes</strong>. Blockchain indexers can take a few minutes to sync and register your payment.</p>
                  </div>

                  <div class="form-row">
                    <div class="field">
                      <label>Chain Used <span class="required">*</span></label>
                      <select name="chain" id="form-chain" required>
                        <option value="">Select chain</option>
                        <option value="ethereum">Ethereum</option>
                        <option value="bnb">BNB Chain</option>
                        <option value="polygon">Polygon</option>
                        <option value="solana">Solana</option>
                        <option value="base">Base</option>
                        <option value="arbitrum">Arbitrum</option>
                        <option value="tron">TRON</option>
                      </select>
                    </div>
                    <div class="field">
                      <label>Token Sent <span class="required">*</span></label>
                      <select name="token" id="form-token" required>
                        <option value="">Select token</option>
                        <option value="USDT">USDT</option>
                        <option value="ETH">ETH</option>
                        <option value="BNB">BNB</option>
                        <option value="POL">POL</option>
                        <option value="SOL">SOL</option>
                        <option value="TRX">TRX</option>
                      </select>
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="field">
                      <label>Amount Sent (USD) <span class="required">*</span></label>
                      <input type="number" name="amount_sent" id="form-amount" required placeholder="500" min="1" step="any">
                    </div>
                    <div class="field">
                      <label>Transaction ID (TxID) <span class="required">*</span></label>
                      <input type="text" name="txid" id="form-txid" required placeholder="0x... or transaction hash">
                      <span class="txid-feedback" id="txid-feedback"></span>
                    </div>
                  </div>

                  <!-- Turnstile Security Challenge -->
                  <div class="form-row" style="margin-top: 15px; margin-bottom: 15px; display: flex; justify-content: center;">
                    <div class="cf-turnstile" data-sitekey="0x4AAAAAADem-VgyP4W5SlpV" data-theme="dark"></div>
                  </div>

                  <!-- Step 3 Part A Support Link -->
                  <div class="verification-support-link">
                    Having issues verifying? Message us on Telegram for support: <a href="https://t.me/FlexistCrypto" target="_blank">@FlexistCrypto</a>
                  </div>

                  <div class="pay-action-row" style="margin-top: 24px;">
                    <button class="ghost-button" type="button" data-back="2">â† Back</button>
                    <button class="neon-button" type="button" id="btn-verify-hash">Verify Transaction Hash â†’</button>
                  </div>
                </div>

                <!-- PART B: ONBOARDING DETAILS -->
                <div id="form-part-details" style="display: none;">
                  <div class="verify-success-badge" id="details-success-badge" style="background: rgba(0, 255, 136, 0.08); border: 1px solid rgba(0, 255, 136, 0.2); border-radius: 8px; padding: 14px 16px; margin-bottom: 20px; font-size: 0.88rem; color: var(--accent-green); text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <span>âœ“</span> <strong>Transaction verified successfully!</strong>
                  </div>

                  <p class="pay-panel-sub" style="margin-bottom: 20px;">Provide your project details to link your verified payment and activate onboarding.</p>

                  <div class="form-row">
                    <div class="field">
                      <label>Full Name <span class="required">*</span></label>
                      <input type="text" name="name" id="form-name" required placeholder="Your name">
                    </div>
                    <div class="field">
                      <label>Email <span class="required">*</span></label>
                      <input type="email" name="email" id="form-email" required placeholder="you@project.xyz">
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="field">
                      <label>Telegram Handle <span class="required">*</span></label>
                      <input type="text" name="telegram" id="form-telegram" required placeholder="@yourtelegram">
                    </div>
                    <div class="field">
                      <label>Project Name <span class="required">*</span></label>
                      <input type="text" name="project" id="form-project" required placeholder="Your project">
                    </div>
                  </div>

                  <!-- Step 3 Part B Support Link -->
                  <div class="verification-support-link">
                    Having issues submitting details? Contact us on Telegram: <a href="https://t.me/FlexistCrypto" target="_blank">@FlexistCrypto</a>
                  </div>

                  <div class="pay-action-row" style="margin-top: 24px;">
                    <button class="ghost-button" type="button" id="btn-back-verification">â† Re-verify</button>
                    <button class="neon-button" type="submit" id="btn-submit">Complete Onboarding & Activate â†’</button>
                  </div>
                </div>
              </form>
            </div>

            <!-- SUCCESS STATE -->
            <div class="pay-success" id="pay-success" hidden>
              <div class="success-checkmark">âœ“</div>
              <h2 class="success-title">Payment Submitted</h2>
              <p class="success-copy">Your confirmation has been received. FLEXIST will verify your transaction within 12 hours and begin onboarding.</p>
              <div class="success-txid" id="success-txid">â€”</div>
              <p style="color: var(--text-muted); font-size: 0.82rem;">Redirecting to next steps...</p>
            </div>
          </div>

          <!-- Right Column: Sticky Pricing/Safety Info -->
          <div class="checkout-sidebar-col">
             <!-- Order Summary Card -->
            <div class="order-summary reveal">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                <h3 class="sidebar-card-title" style="margin-bottom: 0;">Order Details</h3>
                <a href="/plans" id="change-plan-link" class="change-plan-link" style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--accent-cyan); text-decoration: none; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px dashed var(--accent-cyan);">Change Plan</a>
              </div>
              <div class="order-summary-row">
                <span class="order-label">Plan</span>
                <span class="order-value" id="order-plan">â€”</span>
              </div>
              <div class="order-summary-row">
                <span class="order-label">Type</span>
                <span class="order-value" id="order-type">â€”</span>
              </div>
              <div class="order-summary-row">
                <span class="order-label">Amount</span>
                <span class="order-value amount" id="order-amount">â€”</span>
              </div>
            </div>

            <!-- Security Trust Notice -->
            <div class="security-notice reveal">
              <div class="security-item">
                <div class="security-icon">ðŸ”’</div>
                <div>
                  <strong>On-Chain Verification</strong>
                  <p>Payment details are verified directly on-chain using secure Cloudflare Worker endpoints.</p>
                </div>
              </div>
              <div class="security-item">
                <div class="security-icon">ðŸ›¡</div>
                <div>
                  <strong>Verified Wallet</strong>
                  <p>Always confirm the wallet address matches: 0xB980...4E25. Never trust third-party links.</p>
                </div>
              </div>
              <div class="security-item">
                <div class="security-icon">âš¡</div>
                <div>
                  <strong>Fast Verification</strong>
                  <p>Payments are verified within 12 hours. Check status anytime on the status tracker page.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Powered-by Footer -->
    <div class="container">
      <div class="payment-powered-by">Secured by on-chain verification · Powered by blockchain technology</div>
    </div>

  </main>

  <script src="/scripts/payment.js"></script>
</Layout>
