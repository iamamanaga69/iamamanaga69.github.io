# Copy to .env.local and fill in. .env.local is git-ignored — never commit values.
# Anything not prefixed NEXT_PUBLIC_ must stay server-only.

# ── Sanity, public (safe in the browser) ──────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── Sanity, server only ───────────────────────────────────────────────────────
SANITY_API_WRITE_TOKEN=        # writes lead documents from /api/lead
SANITY_API_READ_TOKEN=         # draft mode reads
SANITY_REVALIDATE_SECRET=      # shared secret on the Sanity webhook
SANITY_PREVIEW_SECRET=         # gates /api/draft/enable

# ── Notifications, server only ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=                # optional

# If the NEXT_PUBLIC_SANITY_* vars are empty the data layer must fall back to
# content/*.json from the build kit, so `npm run build` still passes.
