# Sanity — copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Find project ID + dataset at https://sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token — ONLY needed for the one-off migration script. Editor/Deploy token.
# Do NOT expose this to the browser and do NOT commit it.
SANITY_API_WRITE_TOKEN=
